UsePAM yes

PubkeyAuthentication yes
PasswordAuthentication no
KbdInteractiveAuthentication no
PermitEmptyPasswords no
PermitRootLogin no

AuthorizedKeysFile /etc/sftp/authorized_keys/%u

# Disable non-SFTP capabilities globally where possible.
X11Forwarding no
AllowAgentForwarding no
AllowTcpForwarding no
GatewayPorts no
PermitTunnel no
PermitUserEnvironment no
PermitUserRC no
PermitTTY no
MaxSessions 1

LogLevel VERBOSE

HostKey /config/host_keys/ssh_host_ed25519_key
HostKey /config/host_keys/ssh_host_rsa_key

# Generated at container startup from PORT_START..PORT_END.
Include /run/sftp-ports.conf

# Generated by sftpctl from /config/clients/*.json.
Include /etc/ssh/sshd_config.d/90-clients.conf

# Managed users are denied unless an earlier User+LocalPort Match explicitly
# set RefuseConnection=no.
Match Group sftp-clients
    RefuseConnection yes
    ChrootDirectory /data/%u
    ForceCommand internal-sftp -d /incoming -u 077 -l VERBOSE -P remove,rmdir,mkdir,symlink,link,setstat,fsetstat,lsetstat,copy-data
    DisableForwarding yes
    PermitTTY no
    X11Forwarding no
    AllowAgentForwarding no
    AllowTcpForwarding no
    PermitTunnel no

Match all
