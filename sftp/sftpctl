#!/bin/sh
set -eu

CLIENT_DIR="${CLIENT_DIR:-/config/clients}"

AUTH_KEYS_DIR="/etc/sftp/authorized_keys"
LIMITS_DIR="/etc/security/limits.d"
DATA_DIR="/data"

GROUP="sftp-clients"

PORT_START="${PORT_START:-22001}"
PORT_END="${PORT_END:-22100}"

PORTS_PER_SHARD="${PORTS_PER_SHARD:-10}"
SHARD_COUNT="${SHARD_COUNT:-10}"

UID_BASE="${UID_BASE:-20000}"

die() {
  echo "sftpctl: ERROR: $*" >&2
  exit 1
}

log() {
  echo "sftpctl: $*"
}

require_root() {
  [ "$(id -u)" -eq 0 ] || die "must run as root"
}

#
# -------------------------------
# JSON validation
# -------------------------------
#

validate_client_file() {
  file="$1"

  [ -f "$file" ] || {
    echo "$file: file not found" >&2
    return 1
  }

  if ! jq -e '
    type == "object"
    and
    (
      (keys - [
        "user",
        "enabled",
        "port",
        "max_file_mb",
        "allowed_ips",
        "public_keys"
      ])
      | length == 0
    )
    and (.user | type == "string" and length > 0)
    and (.enabled | type == "boolean")
    and (.port | type == "number" and floor == .)
    and (.max_file_mb | type == "number" and floor == . and . > 0)
    and (
      .allowed_ips
      | type == "array"
      and length > 0
      and all(.[]; type == "string" and length > 0)
    )
    and (
      .public_keys
      | type == "array"
      and length > 0
      and all(.[]; type == "string" and length > 0)
    )
  ' "$file" >/dev/null
  then
    echo "$file: invalid schema" >&2
    return 1
  fi

  user="$(jq -r '.user' "$file")"

  if ! printf '%s' "$user" \
      | grep -Eq '^[a-z_][a-z0-9_-]{0,30}$'
  then
    echo "$file: invalid username: $user" >&2
    return 1
  fi

  expected="${user}.json"

  if [ "$(basename "$file")" != "$expected" ]; then
    echo "$file: filename must be $expected" >&2
    return 1
  fi

  port="$(jq -r '.port' "$file")"

  if [ "$port" -lt "$PORT_START" ] \
      || [ "$port" -gt "$PORT_END" ]
  then
    echo \
      "$file: port must be ${PORT_START}..${PORT_END}" \
      >&2

    return 1
  fi

  return 0
}

#
# -------------------------------
# Shard
# -------------------------------
#

get_shard() {
  port="$1"

  shard=$(( (port - PORT_START) / PORTS_PER_SHARD ))

  if [ "$shard" -lt 0 ] \
      || [ "$shard" -ge "$SHARD_COUNT" ]
  then
    die "invalid shard for port $port"
  fi

  echo "$shard"
}

uid_for_port() {
  port="$1"

  echo $((UID_BASE + port - PORT_START))
}

#
# -------------------------------
# Linux user
# -------------------------------
#

ensure_group() {
  if ! getent group "$GROUP" >/dev/null 2>&1; then
    groupadd --system "$GROUP"
  fi
}

ensure_user() {
  user="$1"
  uid="$2"

  ensure_group

  if id "$user" >/dev/null 2>&1; then

    current_uid="$(id -u "$user")"

    if [ "$current_uid" -ne "$uid" ]; then
      die \
        "$user exists with uid=$current_uid but expected uid=$uid"
    fi

    usermod \
      -g "$GROUP" \
      -s /usr/sbin/nologin \
      "$user"

    return
  fi

  if getent passwd "$uid" >/dev/null 2>&1; then
    die "uid $uid already exists"
  fi

  useradd \
    --uid "$uid" \
    --gid "$GROUP" \
    --no-create-home \
    --home-dir / \
    --shell /usr/sbin/nologin \
    "$user"

  log "created user=$user uid=$uid"
}

#
# -------------------------------
# chroot
# -------------------------------
#

ensure_chroot() {
  user="$1"
  uid="$2"

  root="$DATA_DIR/$user"
  incoming="$root/incoming"

  mkdir -p "$incoming"

  #
  # ChrootDirectoryはroot所有必須
  #

  chown root:root "$root"
  chmod 0755 "$root"

  gid="$(getent group "$GROUP" | cut -d: -f3)"

  chown "$uid:$gid" "$incoming"
  chmod 0700 "$incoming"
}

#
# -------------------------------
# authorized_keys
# -------------------------------
#

write_authorized_keys() {
  file="$1"

  user="$(jq -r '.user' "$file")"
  enabled="$(jq -r '.enabled' "$file")"

  target="$AUTH_KEYS_DIR/$user"

  if [ "$enabled" != "true" ]; then
    rm -f "$target"
    return
  fi

  mkdir -p "$AUTH_KEYS_DIR"

  ips="$(jq -r '.allowed_ips | join(",")' "$file")"

  tmp="${target}.tmp.$$"

  : > "$tmp"

  jq -r '.public_keys[]' "$file" |
  while IFS= read -r key; do

    case "$key" in
      ssh-ed25519\ *|\
      ssh-rsa\ *|\
      ecdsa-sha2-nistp256\ *|\
      ecdsa-sha2-nistp384\ *|\
      ecdsa-sha2-nistp521\ *)
        ;;
      *)
        rm -f "$tmp"
        die "invalid public key for $user"
        ;;
    esac

    printf \
      'restrict,from="%s" %s\n' \
      "$ips" \
      "$key" \
      >> "$tmp"

  done

  chown root:root "$tmp"
  chmod 0644 "$tmp"

  mv -f "$tmp" "$target"
}

#
# -------------------------------
# RLIMIT_FSIZE
# -------------------------------
#

write_limit() {
  file="$1"

  user="$(jq -r '.user' "$file")"
  enabled="$(jq -r '.enabled' "$file")"

  target="$LIMITS_DIR/90-sftp-${user}.conf"

  if [ "$enabled" != "true" ]; then
    rm -f "$target"
    return
  fi

  max_file_mb="$(jq -r '.max_file_mb' "$file")"

  #
  # pam_limits fsize = KB
  #

  kb=$((max_file_mb * 1024))

  tmp="${target}.tmp.$$"

  printf \
    '%s - fsize %s\n' \
    "$user" \
    "$kb" \
    > "$tmp"

  chmod 0644 "$tmp"

  mv -f "$tmp" "$target"
}

#
# -------------------------------
# sshd config
# -------------------------------
#

write_common_config() {
  output="$1"
  shard="$2"

  #
  # dummy socket
  #
  # JSONが0件のshardでもsshdを起動可能にする。
  #
  dummy_port=$((22900 + shard))

  cat > "$output" <<EOF
AddressFamily inet

ListenAddress 127.0.0.1:${dummy_port}

UsePAM yes

PubkeyAuthentication yes
PasswordAuthentication no
KbdInteractiveAuthentication no
PermitEmptyPasswords no

PermitRootLogin no

AuthorizedKeysFile /etc/sftp/authorized_keys/%u

X11Forwarding no
AllowAgentForwarding no
AllowTcpForwarding no
GatewayPorts no
PermitTunnel no
PermitUserEnvironment no
PermitUserRC no
PermitTTY no

MaxSessions 1

LogLevel VERBOSE

HostKey /config/host_keys/ssh_host_ed25519_key
HostKey /config/host_keys/ssh_host_rsa_key

PidFile /run/sshd/native-${shard}.pid

EOF
}

build_configs() {

  tmpdir="/run/sshd/new-configs.$$"

  rm -rf "$tmpdir"
  mkdir -p "$tmpdir"

  #
  # 10 shard作成
  #

  shard=0

  while [ "$shard" -lt "$SHARD_COUNT" ]; do

    write_common_config \
      "$tmpdir/shard-${shard}.conf" \
      "$shard"

    shard=$((shard + 1))
  done

  #
  # port重複チェック
  #

  ports_file="$tmpdir/ports"

  : > "$ports_file"

  #
  # ListenAddress追加
  #

  for file in "$CLIENT_DIR"/*.json; do

    [ -e "$file" ] || continue

    case "$file" in
      *.example.json)
        continue
        ;;
    esac

    if ! validate_client_file "$file"; then
      echo \
        "sftpctl: WARN: skipping invalid config: $file" \
        >&2

      continue
    fi

    enabled="$(jq -r '.enabled' "$file")"

    [ "$enabled" = "true" ] || continue

    user="$(jq -r '.user' "$file")"
    port="$(jq -r '.port' "$file")"

    if grep -qx "$port" "$ports_file"; then
      rm -rf "$tmpdir"
      die "duplicate port: $port"
    fi

    echo "$port" >> "$ports_file"

    shard="$(get_shard "$port")"

    config="$tmpdir/shard-${shard}.conf"

    cat >> "$config" <<EOF

ListenAddress 0.0.0.0:${port}

EOF

  done

  #
  # User + LocalPort allowルール
  #

  for file in "$CLIENT_DIR"/*.json; do

    [ -e "$file" ] || continue

    case "$file" in
      *.example.json)
        continue
        ;;
    esac

    validate_client_file "$file" || continue

    enabled="$(jq -r '.enabled' "$file")"

    [ "$enabled" = "true" ] || continue

    user="$(jq -r '.user' "$file")"
    port="$(jq -r '.port' "$file")"

    shard="$(get_shard "$port")"

    config="$tmpdir/shard-${shard}.conf"

    cat >> "$config" <<EOF

Match User ${user} LocalPort ${port}
    RefuseConnection no

Match all

EOF

  done

  #
  # 全shard共通のdefault deny / SFTP設定
  #

  shard=0

  while [ "$shard" -lt "$SHARD_COUNT" ]; do

    config="$tmpdir/shard-${shard}.conf"

    cat >> "$config" <<'EOF'

Match Group sftp-clients

    RefuseConnection yes

    ChrootDirectory /data/%u

    ForceCommand internal-sftp -d /incoming -u 077 -l VERBOSE -P remove,rmdir,mkdir,symlink,link,setstat,fsetstat,lsetstat,copy-data

    DisableForwarding yes

    PermitTTY no
    X11Forwarding no
    AllowAgentForwarding no
    AllowTcpForwarding no
    PermitTunnel no

Match all

EOF

    #
    # sshd設定チェック
    #

    if ! /usr/sbin/sshd \
        -t \
        -f "$config"
    then
      rm -rf "$tmpdir"

      die "sshd -t failed: shard=$shard"
    fi

    shard=$((shard + 1))
  done

  #
  # 全部通ってからatomicに差し替える
  #

  shard=0

  while [ "$shard" -lt "$SHARD_COUNT" ]; do

    mv \
      "$tmpdir/shard-${shard}.conf" \
      "/run/sshd/shard-${shard}.conf"

    shard=$((shard + 1))
  done

  rm -rf "$tmpdir"
}

#
# -------------------------------
# runtime client
# -------------------------------
#

apply_runtime() {
  file="$1"

  validate_client_file "$file" \
    || die "invalid JSON: $file"

  user="$(jq -r '.user' "$file")"
  port="$(jq -r '.port' "$file")"

  uid="$(uid_for_port "$port")"

  ensure_user \
    "$user" \
    "$uid"

  ensure_chroot \
    "$user" \
    "$uid"

  write_authorized_keys "$file"
  write_limit "$file"
}

#
# -------------------------------
# reload
# -------------------------------
#

reload_all_sshd() {

  for pidfile in /run/sshd/shard-*.child.pid; do

    [ -e "$pidfile" ] || continue

    pid="$(cat "$pidfile")"

    if kill -0 "$pid" 2>/dev/null; then

      kill -HUP "$pid"

      log "SIGHUP sshd pid=$pid"
    fi

  done
}

#
# -------------------------------
# apply single
# -------------------------------
#

apply_one() {
  file="$1"

  apply_runtime "$file"

  build_configs

  reload_all_sshd

  log "applied $(jq -r '.user' "$file")"
}

#
# -------------------------------
# apply all
# -------------------------------
#

apply_all() {

  valid_count=0
  invalid_count=0

  for file in "$CLIENT_DIR"/*.json; do

    [ -e "$file" ] || continue

    case "$file" in
      *.example.json)
        continue
        ;;
    esac

    if validate_client_file "$file"; then

      apply_runtime "$file"

      valid_count=$((valid_count + 1))

    else

      echo \
        "sftpctl: WARN: invalid client ignored: $file" \
        >&2

      invalid_count=$((invalid_count + 1))

    fi

  done

  build_configs

  reload_all_sshd

  log \
    "apply-all completed valid=$valid_count invalid=$invalid_count"
}

#
# -------------------------------
# status
# -------------------------------
#

status_client() {

  name="$1"

  file="$CLIENT_DIR/$name.json"

  [ -f "$file" ] \
    || die "not found: $name"

  validate_client_file "$file" \
    || die "invalid config"

  user="$(jq -r '.user' "$file")"
  port="$(jq -r '.port' "$file")"
  shard="$(get_shard "$port")"

  echo "user:  $user"
  echo "port:  $port"
  echo "shard: $shard"
  echo

  echo "Linux user:"
  getent passwd "$user" || true

  echo
  echo "PAM limit:"

  cat \
    "$LIMITS_DIR/90-sftp-${user}.conf" \
    2>/dev/null \
    || echo "(none)"

  echo
  echo "sshd listener:"

  grep \
    "^ListenAddress " \
    "/run/sshd/shard-${shard}.conf" \
    || true
}

#
# -------------------------------
# main
# -------------------------------
#

require_root

command="${1:-}"

case "$command" in

  apply)

    [ "$#" -eq 2 ] \
      || die "usage: sftpctl apply <client>"

    apply_one \
      "$CLIENT_DIR/$2.json"
    ;;

  apply-file)

    [ "$#" -eq 2 ] \
      || die "usage: sftpctl apply-file <path>"

    apply_one "$2"
    ;;

  apply-all)

    apply_all
    ;;

  status)

    [ "$#" -eq 2 ] \
      || die "usage: sftpctl status <client>"

    status_client "$2"
    ;;

  show)

    [ "$#" -eq 2 ] \
      || die "usage: sftpctl show <client>"

    jq . "$CLIENT_DIR/$2.json"
    ;;

  *)

    cat <<'EOF'
Usage:

  sftpctl apply <client>
  sftpctl apply-file <json>
  sftpctl apply-all
  sftpctl status <client>
  sftpctl show <client>

EOF
    ;;

esac